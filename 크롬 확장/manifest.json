{
  "manifest_version": 3,
  "name": "ONE PACE",
  "version": "1.0.4",

  "icons": {
    "128": "assets/onepace-logo.png"
  },
  
  "description": "ONE PACE global communication assistant",
  
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*",
    "https://api.onepace.site/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content-ui.html",
        "content.css",
        "popup.css",
        "sidepanel.css"
      ],
      "matches": [
        "<all_urls>",
        "file:///*"
      ]
    }
  ],

  "side_panel": {
    "default_path": "sidepanel.html"
  }
}